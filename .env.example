# Copy to .env.local and fill in. Find both in Supabase → Project Settings → API Keys.
# Only use the PUBLISHABLE key here — never the secret (sb_secret_…) key; this file ships to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
